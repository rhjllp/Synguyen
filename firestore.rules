rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.pts == 0
        && request.resource.data.streak == 0
        && request.resource.data.used.size() == 0;
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pts','streak','last','used'])
        && (
          // đổi code: thêm đúng 1 code và cộng đúng điểm thưởng của code đó
          (request.resource.data.used.size() == resource.data.used.size() + 1
            && request.resource.data.used.hasAll(resource.data.used)
            && request.resource.data.streak == resource.data.streak
            && request.resource.data.last == resource.data.last
            && request.resource.data.pts - resource.data.pts ==
               get(/databases/$(database)/documents/codes/$(request.resource.data.used[request.resource.data.used.size() - 1])).data.reward)
          ||
          // điểm danh: cộng tối đa 100 điểm
          (request.resource.data.used == resource.data.used
            && request.resource.data.last != resource.data.last
            && request.resource.data.pts - resource.data.pts > 0
            && request.resource.data.pts - resource.data.pts <= 100)
        ));
      allow delete: if isAdmin();
    }

    match /names/{n} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /codes/{c} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
